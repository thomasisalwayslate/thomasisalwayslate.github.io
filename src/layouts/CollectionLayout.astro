---
import WebAnalytics from '../components/WebAnalytics.astro';
interface Props { title: string; description?: string; ogImage?: string; compact?: boolean; backToCollection?: boolean; collectionIndex?: boolean; research?: 'index' | 'article'; noindex?: boolean; articleMeta?: { published: string; updated?: string };  }
const { title, description = 'A living collection of apps, games and small software by Thomas.', ogImage = '/assets/dither-reflection.png', compact = false, backToCollection = false, collectionIndex = false, research, noindex = false, articleMeta } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const section = research ? { label:'research', href:'/research' } : { label:'portfolio', href:'/home' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121212" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:type" content={articleMeta ? "article" : "website"} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {articleMeta && <meta property="article:published_time" content={articleMeta.published} />}
    {articleMeta?.updated && <meta property="article:modified_time" content={articleMeta.updated} />}
    <link rel="alternate" type="application/rss+xml" title="Thomas — research" href="/rss.xml" />
    <meta property="og:site_name" content="thomas — collection" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('journalTheme') === 'dark' ? 'dark' : 'light'; } catch (_) {}
    </script>
  </head>
  <body class:list={{'collection-desk':compact, 'detail-desk':backToCollection || research==='article'}}>
    <div class:list={['collection-shell', {compact, 'square-index':collectionIndex || research==='index', 'collection-index':collectionIndex, 'research-index':research==='index', 'project-page':backToCollection, 'research-article':research==='article'}]}>
      <header class="site-header">
        <a class="owner" href={section.href}><img src="/assets/avatar-dither.png" width="32" height="32" alt="" /><span>{section.label}</span></a>
        <nav aria-label="Site navigation">
          <a href="/">id card</a>
          <button id="theme-toggle" type="button" aria-label="Switch to dark appearance">
            <svg width="20" height="20" viewBox="0 0 20 20" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true">
              <g class="sun-icon">
                <path d="M8 6h4v1h1v1h1v4h-1v1h-1v1H8v-1H7v-1H6V8h1V7h1Z"/>
                <path d="M9 1h2v3H9zM9 16h2v3H9zM1 9h3v2H1zM16 9h3v2h-3zM3 3h2v2H3zM15 3h2v2h-2zM3 15h2v2H3zM15 15h2v2h-2z"/>
              </g>
              <g class="moon-icon">
                <path d="M8 2h4v2h-2v2H9v4h1v2h2v1h4v-1h2v3h-2v2h-3v1H8v-1H5v-2H3v-3H2V8h1V5h2V3h3Z"/>
                <path d="M15 2h1v2h2v1h-2v2h-1V5h-2V4h2Z"/>
              </g>
            </svg>
          </button>
        </nav>
      </header>
      <main id="main"><slot /></main>
      {!compact && <footer class="site-footer"><span>a collection by thomas</span><a href="https://github.com/thomasisalwayslate">github</a><a href="https://x.com/thomasisalwayslate">say hello</a></footer>}
    </div>
    {compact && <footer class="identity-footer">&copy; 2026 thomasisalwayslate</footer>}
    <script is:inline>
      (function () {
        var button = document.getElementById('theme-toggle');
        function label() { button.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? 'Switch to light appearance' : 'Switch to dark appearance'); }
        label();
        button.addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('journalTheme', next); } catch (_) {}
          label();
        });
      })();
    </script>
    <WebAnalytics />
  </body>
</html>
<style is:global>
  @font-face { font-family:Galmuri; src:url('/assets/fonts/Galmuri11.woff2') format('woff2'); font-weight:400; font-display:swap; }
  @font-face { font-family:Galmuri; src:url('/assets/fonts/Galmuri11-Bold.woff2') format('woff2'); font-weight:700; font-display:swap; }
  :root { color-scheme: light; --paper:#fafafa; --panel:#fafafa; --ink:#121212; --muted:#62676b; --line:#d4d8e0; --tray:#fafafa; --edge:#acacac; --mono:'SFMono-Regular',ui-monospace,Menlo,monospace; --sans:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif; }
  :root[data-theme='dark'] { color-scheme:dark; --paper:#121212; --panel:#121212; --ink:#fafafa; --muted:#acacac; --line:#363636; --tray:#121212; --edge:#666666; }
  * { box-sizing:border-box; }
  @keyframes dot-drift { from { background-position:0 0; } to { background-position:140px 140px; } }
  body { margin:0; padding:28px; background-color:var(--paper); background-image:radial-gradient(circle,rgba(54,54,54,.08) 1px,transparent 1px); background-size:7px 7px; animation:dot-drift 18s linear infinite; color:var(--ink); font-family:var(--sans); -webkit-font-smoothing:antialiased; }
  @media (prefers-reduced-motion:reduce) { body { animation:none; } }
  :root[data-theme='dark'] body { background-image:radial-gradient(circle,rgba(250,250,250,.10) 1px,transparent 1px); }
  a { color:inherit; text-underline-offset:4px; }
  button { font:inherit; color:inherit; }
  a:focus-visible, button:focus-visible { outline:2px solid var(--ink); outline-offset:5px; }
  img { display:block; max-width:100%; }
  .collection-shell { position:relative; z-index:1; max-width:1120px; min-height:calc(100svh - 56px); margin:0 auto; background:var(--paper); border:1px solid var(--edge); border-radius:8px; }
  .collection-shell.compact { max-width:560px; min-height:0; margin:clamp(24px,10vh,80px) auto; border-radius:0; font-family:Galmuri,var(--mono); font-size:12px; }
  .compact .site-header { padding:12px 18px; gap:12px; }
  .compact .owner { font-family:Galmuri,var(--mono); font-size:12px; font-weight:700; letter-spacing:0; }
  .compact .owner img { width:24px; height:24px; }
  .compact .site-header nav { gap:16px; }
  .compact .site-header nav a { display:inline-flex; align-items:center; justify-content:center; height:44px; padding-block:0; white-space:nowrap; font-family:Galmuri,var(--mono); }
  .compact #theme-toggle { border-radius:12px; }
  .compact main { padding:28px; }
  .site-header { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:20px 32px; border-bottom:1px solid var(--line); }
  .owner { display:flex; align-items:center; gap:10px; min-height:44px; text-decoration:none; font-size:16px; font-weight:600; letter-spacing:-.03em; }
  .owner img { image-rendering:auto; border:1px solid var(--line); border-radius:6px; }
  .site-header nav { display:flex; align-items:center; gap:24px; }
  .site-header nav a { min-width:44px; text-align:center; font:12px var(--mono); text-decoration:none; color:var(--muted); padding-block:15px; }
  .site-header nav a:hover, .site-header nav a[aria-current='page'] { color:var(--ink); text-decoration:underline; }
  #theme-toggle { display:grid; place-items:center; width:44px; height:44px; border:1px solid var(--line); background:var(--panel); border-radius:50%; cursor:pointer; }
  #theme-toggle:hover { border-color:var(--ink); }
  #theme-toggle .moon-icon { display:none; }
  :root[data-theme='dark'] #theme-toggle .sun-icon { display:none; }
  :root[data-theme='dark'] #theme-toggle .moon-icon { display:inline; }
  main { padding:44px 32px 48px; }
  .site-footer { display:flex; align-items:center; gap:24px; padding:24px 32px; border-top:1px solid var(--line); font:11px var(--mono); color:var(--muted); }
  .site-footer span { margin-right:auto; }
  .site-footer a { padding-block:12px; }
  ::selection { background:var(--ink); color:var(--paper); }
  @media (max-width:720px) { body { padding:12px; } .collection-shell { min-height:calc(100svh - 24px); } .site-header { padding:12px 18px; gap:12px; } .site-header nav { gap:14px; } main { padding:30px 18px; } .site-footer { padding:16px 18px; gap:18px; } }
  @media (max-width:380px) { body { padding:6px; } .site-header { padding:10px 12px; } .site-header nav { gap:10px; } .owner { gap:6px; } main { padding:24px 12px; } .site-footer { padding:12px; gap:12px; } }
  @media (max-width:380px) { .compact .site-header { padding:10px 12px; } .compact .site-header nav { gap:10px; } .compact main { padding:20px; } }
  body.collection-desk { position:relative; min-height:100svh; display:grid; place-items:center; padding:48px 12px; }
  .collection-desk .collection-shell.compact { width:100%; margin:0; border-radius:12px; }
  .collection-desk .collection-shell.compact.square-index { container-type:inline-size; max-width:480px; aspect-ratio:1; display:flex; flex-direction:column; --collection-padding:clamp(12px,5.8cqw,28px); --collection-gap:clamp(12px,5cqw,24px); --card-size:clamp(84px,calc((100cqw - 144px) / 2),160px); }
  .compact.square-index main { flex:1; min-height:0; display:grid; place-items:center; padding:var(--collection-padding); }
  body.collection-desk.detail-desk { padding:48px 24px 64px; }
  .collection-desk .collection-shell.compact.project-page { max-width:880px; min-height:562px; display:flex; flex-direction:column; }
  .compact.project-page main { flex:1; display:grid; padding:24px; }
  .collection-desk .collection-shell.compact.research-article { max-width:880px; min-height:0; }
  .identity-footer { position:absolute; bottom:18px; left:0; right:0; text-align:center; font:10px var(--mono); color:var(--muted); }
  @media(max-width:900px) { .collection-desk .collection-shell.compact.project-page { min-height:0; } }
  @media(max-width:700px) {
    body.collection-desk { padding-block:24px 60px; }
    body.collection-desk.detail-desk { padding:24px 16px 54px; }
    .collection-desk .collection-shell.compact.project-page { min-height:0; }
    .compact.project-page main, .compact.research-article main { padding:20px; }
  }
  @media(max-width:360px) {
    .compact .site-header { padding:10px 12px; gap:8px; }
    .compact .site-header nav { gap:8px; }
    .compact .site-header nav a { font-size:11px; }
    .compact .owner { gap:6px; }
    .compact.project-page main, .compact.research-article main { padding:16px; }
  }
  @media(max-width:600px) {
    body.collection-desk:has(.research-index) { display:flex; flex-direction:column; align-items:center; justify-content:flex-start; gap:24px; padding:20px 12px 24px; }
    .collection-desk .collection-shell.compact.research-index { aspect-ratio:auto; }
    .compact.research-index main { display:block; padding:16px; }
    body.collection-desk:has(.research-index) .identity-footer { position:static; width:100%; margin-top:auto; }
  }
</style>
