---
import CollectionLayout from '../../layouts/CollectionLayout.astro';
import { publishedArticles, articleUrl, displayDate, readingMinutes } from '../../lib/articles';
const notes = (await publishedArticles()).map(article => ({
  href: articleUrl(article),
  title: article.data.title,
  description: article.data.summary ?? article.data.description,
  date: article.data.published.toISOString(),
  dateLabel: displayDate(article.data.published),
  minutes: readingMinutes(article),
}));
---
<CollectionLayout title="Research | thomas" description="Research notes and experiments by Thomas." compact research="index">
  <header class="research-heading">
    <h1>research</h1>
  </header>
  <ul class="research-grid">
    {notes.map(note => <li><article>
      <a class="note-card" href={note.href}>
        <div class="note-content">
          <h2>{note.title}</h2>
          <p>{note.description}</p>
          <div class="note-meta"><time datetime={note.date}>{note.dateLabel}</time><span>{note.minutes} min read</span></div>
        </div>
      </a>
    </article></li>)}
  </ul>
</CollectionLayout>
<style>
  .research-heading { margin-bottom:28px; }
  h1 { margin:0; font:400 13px/1.6 Galmuri,var(--mono); color:var(--muted); }
  .research-grid { width:100%; min-width:0; list-style:none; padding:0; margin:0; }
  .research-grid > li { min-width:0; }
  .research-grid > li + li { border-top:1px solid var(--line); }
  .note-card { display:block; padding:0 0 28px; text-decoration:none; }
  .research-grid > li + li .note-card { padding-top:28px; }
  .note-card:hover h2 { text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:5px; }
  .note-content { min-width:0; font-family:var(--sans); }
  .note-meta { display:flex; flex-wrap:wrap; align-items:center; gap:6px 18px; margin-top:14px; font:11px/1.6 Galmuri,var(--mono); color:var(--muted); }
  h2 { margin:0 0 12px; font:700 18px/1.65 Galmuri,var(--mono); overflow-wrap:anywhere; }
  .note-content p { max-width:68ch; margin:0; font:14px/1.75 var(--sans); color:var(--muted); }
  @media(max-width:560px) {
    h2 { font-size:16px; }
    .note-meta { font-size:10px; gap:6px 14px; }
  }
</style>
