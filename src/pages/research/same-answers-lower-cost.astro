---
import CollectionLayout from '../../layouts/CollectionLayout.astro';
import DoomEasterEgg from '../../components/DoomEasterEgg.astro';
import { Content, frontmatter } from '../../articles/same-answers-lower-cost.md';


---
<CollectionLayout title={`${frontmatter.title} | thomas`} description={frontmatter.description} compact research="article">
  <article class="eaos-article">
    <div class="article-meta"><span>thomasisalwayslate</span><time datetime="2026-10-18">18 October 2026</time></div>
    <Content />
    <DoomEasterEgg />
  </article>
</CollectionLayout>
<style is:global>
  .collection-shell.research-article:has(.eaos-article) { min-width:0; }
  .eaos-article { width:100%; min-width:0; max-width:740px; margin:0 auto; font:16px/1.8 var(--sans); overflow-wrap:anywhere; }
  .eaos-article .article-meta { display:flex; flex-wrap:wrap; gap:8px 20px; margin-bottom:20px; color:var(--muted); font:12px/1.5 var(--mono); }
  .eaos-article h1 { margin:0 0 24px; font:700 clamp(28px,4.3vw,40px)/1.15 var(--sans); letter-spacing:-.035em; }
  .eaos-article h2 { margin:40px 0 14px; font:700 24px/1.3 var(--sans); letter-spacing:-.025em; }
  .eaos-article p { margin:0 0 20px; }
  .eaos-article h1 + p { font-size:19px; line-height:1.65; }
  .eaos-article table { display:block; width:100%; max-width:100%; overflow-x:auto; border-collapse:collapse; margin:24px 0; font-size:12px; line-height:1.6; font-variant-numeric:tabular-nums; }
  .eaos-article th, .eaos-article td { padding:12px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
  .eaos-article th { font-weight:600; }
  .eaos-article th:first-child, .eaos-article td:first-child { min-width:155px; text-align:left; }
  .eaos-article th:not(:first-child), .eaos-article td:not(:first-child) { min-width:100px; }
  .eaos-article pre { overflow-x:auto; padding:16px; border:1px solid var(--line); border-radius:8px; font:14px/1.6 var(--mono); }
  .eaos-article code { font-family:var(--mono); }
  @media(max-width:600px) { .eaos-article { font-size:15px; } .eaos-article h1 + p { font-size:17px; } .eaos-article h2 { font-size:21px; } }
</style>
