---
import { getEntry } from 'astro:content';
import HuhuArticle from '../../content/articles/huhu.it.astro';
import source from '../../content/articles/huhu.it.astro?raw';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { articleUrl, interactiveHeadings } from '../../lib/articles';

const original = await getEntry('articles', 'huhu');
if (!original) throw new Error('The huhu article is missing from the articles collection.');
const article = {
  ...original,
  data: {
    ...original.data,
    title: 'huhu: le strade che può prendere una vita',
    description: 'Sto costruendo huhu per conservare quello che mi succede, ritrovare il filo tra un episodio e l’altro e capire, dai miei appunti, che cosa potrebbe succedere dopo.',
  },
};
---
<ArticleLayout
  {article}
  lang="it"
  alternate={{ href: articleUrl(original), lang: 'en' }}
  headings={interactiveHeadings(source)}
  interactiveSource={source}
  ogImage={original.data.still ?? undefined}
>
  <HuhuArticle />
</ArticleLayout>
