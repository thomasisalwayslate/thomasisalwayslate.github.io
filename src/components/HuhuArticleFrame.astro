<div class="research-note"><slot /></div>

<script>
  // Keep links from the graph and older article bookmarks useful inside closed notes.
  function revealSection(hash = window.location.hash) {
    if (!hash) return;
    let id: string;
    try { id = decodeURIComponent(hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    if (!target) return;
    let element: HTMLElement | null = target;
    while (element) {
      if (element instanceof HTMLDetailsElement) element.open = true;
      element = element.parentElement;
    }
    requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  }
  window.addEventListener('hashchange', () => revealSection());
  document.addEventListener('click', event => {
    const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null;
    if (!(anchor instanceof HTMLAnchorElement)) return;
    const url = new URL(anchor.href);
    if (url.origin === location.origin && url.pathname === location.pathname && url.hash) revealSection(url.hash);
  });
  revealSection();
</script>
<style is:global>
  .research-note { font:17px/1.75 var(--sans); letter-spacing:normal; }
  .research-note .prose { max-width:660px; margin-inline:auto; }
  .research-note .article-meta { display:flex; flex-wrap:wrap; gap:5px 16px; color:var(--muted); font-size:13px; margin-bottom:20px; }
  .research-note h1 { margin:0 0 24px; font:650 clamp(29px,4vw,38px)/1.2 var(--sans); letter-spacing:-.025em; }
  .research-note .abstract { font-size:19px; line-height:1.65; }
  .research-note p:not(:where(huhu-demo *)) { margin:0 0 20px; }
  .research-note p:last-child:not(:where(huhu-demo *)) { margin-bottom:0; }
  .article-body .research-note h2:not(:where(huhu-demo *)) { font:650 24px/1.3 var(--sans); letter-spacing:-.015em; margin:0 0 18px; }
  .article-body .research-note h3:not(:where(huhu-demo *)) { font:600 20px/1.4 var(--sans); margin:0 0 16px; }
  .research-note section:not(:where(huhu-demo *)) { margin-block:36px; }
  .research-note [id]:not(:where(huhu-demo *)) { scroll-margin-top:24px; }
  .research-note code:not(:where(huhu-demo *)) { font:.88em/1.6 var(--mono); overflow-wrap:anywhere; }
  .research-note .name-origin { margin-block:24px; padding-left:14px; border-left:2px solid var(--line); color:var(--muted); font-size:14px; line-height:1.65; }
  .research-note .name-origin strong { color:var(--ink); }
  .research-note .pronunciation { margin-inline:4px; }
  .research-note .article-contents { display:flex; flex-wrap:wrap; gap:0 22px; margin-top:24px; padding-block:8px; border-block:1px solid var(--line); font-size:14px; }
  .research-note .article-contents a { display:inline-flex; align-items:center; min-height:44px; }
  .article-body .research-note blockquote { margin:24px 0; padding:14px 18px; border-left:2px solid var(--ink); font-size:21px; line-height:1.6; }
  .research-note .definitions { margin:20px 0; border-block:1px solid var(--line); font-size:16px; }
  .research-note .definitions div { display:grid; grid-template-columns:130px minmax(0,1fr); gap:16px; padding:12px 0; }
  .research-note .definitions div+div { border-top:1px solid var(--line); }
  .research-note dt { font-weight:600; }
  .research-note dd { margin:0; }
  .research-note .expandable { margin:20px 0; border:1px solid var(--line); border-radius:8px; }
  .research-note summary { min-height:48px; padding:14px 16px; cursor:pointer; font-size:15px; font-weight:600; line-height:1.5; }
  .research-note summary:focus-visible { outline:2px solid var(--ink); outline-offset:3px; }
  .research-note .expandable[open]>summary { border-bottom:1px solid var(--line); }
  .research-note .note-body { padding:20px 16px; font-size:16px; min-width:0; }
  .research-note .note-body>:last-child { margin-bottom:0; }
  .research-note .chain-diagram { margin:24px 0; padding:22px; border:1px solid var(--line); border-radius:10px; }
  .research-note .chain-diagram ol { list-style:none; padding:0; margin:0; }
  .research-note .chain-diagram li { position:relative; padding:12px; border:1px solid var(--edge); border-radius:6px; text-align:center; font-size:15px; line-height:1.5; overflow-wrap:anywhere; }
  .research-note .chain-diagram li+li { margin-top:28px; }
  .research-note .chain-diagram li+li::before { content:'↓'; position:absolute; top:-26px; left:0; right:0; color:var(--muted); }
  .research-note .other-route { margin:18px 0 0; padding-top:16px; border-top:1px dashed var(--edge); text-align:center; font-size:14px; }
  .article-body .research-note figcaption { margin-top:14px; text-align:center; font-size:13px; line-height:1.6; color:var(--muted); }
  .article-body .research-note table { width:100%; table-layout:fixed; border-collapse:collapse; margin:24px 0; font-size:14px; line-height:1.6; }
  .research-note caption { margin-bottom:12px; text-align:left; font-size:13px; color:var(--muted); }
  .research-note th, .research-note td { border-top:1px solid var(--line); padding:12px 10px 12px 0; text-align:left; vertical-align:top; overflow-wrap:anywhere; }
  .research-note tbody th { font-weight:400; }
  .research-note .field-table th:first-child { width:34%; }
  .research-note .factor-table th:first-child, .research-note .score-table th:first-child { width:70%; }
  .research-note .factor-table td, .research-note .score-table td, .research-note .comparison-table td { font-variant-numeric:tabular-nums; }
  .research-note .comparison-table small { display:block; font-size:12px; color:var(--muted); }
  .research-note .method-steps { padding-left:22px; }
  .research-note .method-steps li { margin-bottom:12px; padding-left:3px; }
  .research-note .equations { margin:24px 0; padding:18px 14px; border:1px solid var(--line); border-radius:8px; text-align:center; overflow-wrap:anywhere; }
  .research-note .equations p { font-size:14px; margin-bottom:12px; }
  .research-note .equations strong { font-size:20px; font-weight:600; font-variant-numeric:tabular-nums; }
  .research-note .model-equations { display:flex; flex-direction:column; gap:8px; }
  .research-note .example-note { font-size:14px; color:var(--muted); }
  .research-note .hive-note .note-body { padding:16px 12px; }
  .research-note .terminal-preview figure { margin:0; padding:12px; }
  .research-note .terminal-preview a { display:block; border-radius:6px; overflow:hidden; }
  .research-note .terminal-preview a:focus-visible { outline:2px solid var(--ink); outline-offset:3px; }
  .research-note .terminal-preview img { display:block; width:100%; height:auto; background:#17191c; }
  .research-note .article-end { display:flex; align-items:center; flex-wrap:wrap; justify-content:space-between; gap:8px 20px; border-top:1px solid var(--line); padding-top:20px; font-size:13px; color:var(--muted); }
  .research-note .article-end a { display:inline-flex; align-items:center; min-height:44px; }
  .research-note .lens-table th:first-child { width:30%; font-weight:600; }
  .research-note .question-list { padding-left:22px; margin:0 0 20px; }
  .research-note .question-list li { margin-bottom:8px; }
  @media(max-width:600px) {
    .research-note { font-size:16px; }
    .research-note .abstract { font-size:18px; }
    .article-body .research-note h2:not(:where(huhu-demo *)) { font-size:22px; }
    .research-note .article-contents { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 14px; }
    .research-note .article-contents a { padding-block:8px; }
    .article-body .research-note blockquote { font-size:19px; padding:12px 16px; }
    .research-note .definitions div { grid-template-columns:1fr; gap:4px; }
    .research-note summary { padding:14px 12px; }
    .research-note .note-body { padding:16px 12px; }
    .research-note .chain-diagram { padding:16px 12px; }
    .research-note .hive-note .note-body { padding:16px 8px 8px; }
    .research-note .hive-note .note-body>p { margin-inline:4px; }
    .research-note .equations { padding:16px 10px; }
    .research-note .equations strong { font-size:18px; }
    .research-note .field-table th:first-child { width:40%; }
    .research-note .factor-table th:first-child, .research-note .score-table th:first-child { width:62%; }
  }
</style>
